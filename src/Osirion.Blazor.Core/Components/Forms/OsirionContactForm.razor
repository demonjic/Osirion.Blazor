@namespace Osirion.Blazor.Components
@inherits OsirionComponentBase
@attribute [StreamRendering(true)]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using Osirion.Blazor.Core.Models

<div class="@GetContactFormContainerClass()" style="@Style" @attributes="Attributes">
    <div class="osirion-contact-form-wrapper">
        <!-- Form Section -->
        <div class="osirion-contact-form-section">
            @if (!string.IsNullOrWhiteSpace(FormTitle))
            {
                <h2 class="osirion-contact-form-title">@FormTitle</h2>
            }

            @if (!string.IsNullOrWhiteSpace(FormDescription))
            {
                <p class="osirion-contact-form-description">@FormDescription</p>
            }

            <!-- Submission Status Messages -->
            @if (SubmissionResult.HasValue && SubmissionResult != ContactFormSubmissionResult.None && SubmissionResult != ContactFormSubmissionResult.Processing)
            {
                <div class="@GetStatusMessageClass()">
                    @GetStatusIcon()
                    <span>@GetStatusMessage()</span>
                </div>
            }

            <!-- Contact Form -->
            <EditForm Enhance EditContext="@_editContext" OnValidSubmit="@HandleValidSubmit" class="osirion-contact-form" FormName="@Id">

                <!-- Honeypot for spam protection (hidden) -->
                <div class="osirion-honeypot" aria-hidden="true">
                    <InputText @bind-Value="FormModel.Website" tabindex="-1" autocomplete="off" />
                </div>

                <!-- Name Field -->
                <div class="osirion-form-group">
                    <label for="@($"contact-name-{Id}")" class="@GetLabelClass()">
                        @($" {NameLabel} ")@if (ShowRequiredIndicators) {
                        <span class="osirion-required">*</span>
                                                }
                    </label>
                    <InputText id="@($"contact-name-{Id}")"
                               @bind-Value="FormModel.Name"
                               class="@GetInputClass()"
                               placeholder="@NamePlaceholder"
                               aria-describedby="@($"name-error-{Id}")" />
                    <ValidationMessage For="@(() => FormModel.Name)" class="osirion-validation-message" id="@($"name-error-{Id}")" />
                </div>

                <!-- Email Field -->
                <div class="osirion-form-group">
                    <label for="@($"contact-email-{Id}")" class="@GetLabelClass()">
                        @($" {EmailLabel} ")@if (ShowRequiredIndicators) 
                        {
                        <span class="osirion-required">*</span>
                        }
                    </label>
                    <InputText id="@($"contact-email-{Id}")"
                               @bind-Value="FormModel.Email"
                               type="email"
                               class="@GetInputClass()"
                               placeholder="@EmailPlaceholder"
                               aria-describedby="@($"email-error-{Id}")" />
                    <ValidationMessage For="@(() => FormModel.Email)" class="osirion-validation-message" id="@($"email-error-{Id}")" />
                </div>

                <!-- Subject Field -->
                <div class="osirion-form-group">
                    <label for="@($"contact-subject-{Id}")" class="@GetLabelClass()">
                        @($" {SubjectLabel} ")@if (ShowRequiredIndicators) {
                        <span class="osirion-required">*</span>
                                                }
                    </label>
                    <InputText id="@($"contact-subject-{Id}")"
                               @bind-Value="FormModel.Subject"
                               class="@GetInputClass()"
                               placeholder="@SubjectPlaceholder"
                               aria-describedby="@($"subject-error-{Id}")" />
                    <ValidationMessage For="@(() => FormModel.Subject)" class="osirion-validation-message" id="@($"subject-error-{Id}")" />
                </div>

                <!-- Message Field -->
                <div class="osirion-form-group">
                    <label for="@($"contact-message-{Id}")" class="@GetLabelClass()">
                        @($" {MessageLabel} ")@if (ShowRequiredIndicators) {
                        <span class="osirion-required">*</span>
                                                }
                    </label>
                    <InputTextArea id="@($"contact-message-{Id}")"
                                   @bind-Value="FormModel.Message"
                                   class="@GetTextAreaClass()"
                                   placeholder="@MessagePlaceholder"
                                   rows="@MessageRows"
                                   aria-describedby="@($"message-error-{Id}")" />
                    <ValidationMessage For="@(() => FormModel.Message)" class="osirion-validation-message" id="@($"message-error-{Id}")" />
                </div>

                <!-- Additional Fields -->
                @foreach (var definition in _fields)
                {
                    var inputId = FieldInputId(definition);
                    var error = FieldError(definition);
                    var invalid = error is null ? null : "true";
                    var describedBy = FieldDescribedBy(definition, error);
                    var showRequired = definition.Required && ShowRequiredIndicators;
                    var inputName = ContactFormFieldRules.InputName(definition);
                    if (ContactFormFieldRules.IsGroup(definition))
                    {
                        var isRadio = definition.Type == ContactFormFieldType.Radio;
                        <fieldset class="osirion-form-group osirion-form-fieldset" aria-describedby="@describedBy">
                            <legend class="@GetLabelClass()">
                                @definition.Label
                                @if (showRequired)
                                {
                                    <span class="osirion-required" aria-hidden="true">*</span>
                                }
                            </legend>
                            @for (var index = 0; index < definition.Options.Count; index++)
                            {
                                var option = definition.Options[index];
                                <label class="osirion-form-checkbox-label osirion-form-option" for="@($"{inputId}-{index}")">
                                    @if (isRadio)
                                    {
                                        <input id="@($"{inputId}-{index}")" type="radio" name="@inputName" value="@option.Value"
                                               class="@GetRadioClass()" checked="@IsChosen(definition, option)"
                                               required="@definition.Required" aria-invalid="@invalid"
                                               @onchange="@(() => SetFieldValue(definition, option.Value))" />
                                    }
                                    else
                                    {
                                        <input id="@($"{inputId}-{index}")" type="checkbox" name="@inputName" value="@option.Value"
                                               class="@GetCheckboxClass()" checked="@IsChosen(definition, option)" aria-invalid="@invalid"
                                               @onchange="@(args => SetOptionChosen(definition, option.Value, args.Value))" />
                                    }
                                    <span class="osirion-checkbox-text">@option.DisplayLabel</span>
                                </label>
                            }
                            @if (!string.IsNullOrWhiteSpace(definition.HelpText))
                            {
                                <p class="osirion-form-help" id="@FieldHelpId(definition)">@definition.HelpText</p>
                            }
                            @if (error is not null)
                            {
                                <div class="osirion-validation-message" id="@FieldErrorId(definition)">@error</div>
                            }
                        </fieldset>
                    }
                    else
                    {
                        <div class="osirion-form-group">
                            <label for="@inputId" class="@GetLabelClass()">
                                @definition.Label
                                @if (showRequired)
                                {
                                    <span class="osirion-required" aria-hidden="true">*</span>
                                }
                            </label>
                            @if (definition.Type == ContactFormFieldType.Select)
                            {
                                <select id="@inputId" name="@inputName" class="@GetSelectClass()" required="@definition.Required"
                                        aria-describedby="@describedBy" aria-invalid="@invalid"
                                        @onchange="@(args => SetFieldValue(definition, args.Value))">
                                    <option value="">@definition.Placeholder</option>
                                    @foreach (var option in definition.Options)
                                    {
                                        <option value="@option.Value" selected="@IsChosen(definition, option)">@option.DisplayLabel</option>
                                    }
                                </select>
                            }
                            else if (definition.Type == ContactFormFieldType.MultilineText)
                            {
                                <textarea id="@inputId" name="@inputName" class="@GetTextAreaClass()" rows="4"
                                          required="@definition.Required" maxlength="@ContactFormFieldRules.MaxLength(definition)"
                                          placeholder="@definition.Placeholder" aria-describedby="@describedBy" aria-invalid="@invalid"
                                          @onchange="@(args => SetFieldValue(definition, args.Value))">@FieldValue(definition)</textarea>
                            }
                            else if (definition.Type == ContactFormFieldType.Number)
                            {
                                <input id="@inputId" name="@inputName" type="number" class="@GetInputClass()" step="any"
                                       min="@ContactFormFieldRules.FormatNumber(definition.Min)" max="@ContactFormFieldRules.FormatNumber(definition.Max)"
                                       required="@definition.Required" placeholder="@definition.Placeholder" value="@FieldValue(definition)"
                                       aria-describedby="@describedBy" aria-invalid="@invalid"
                                       @onchange="@(args => SetFieldValue(definition, args.Value))" />
                            }
                            else
                            {
                                <input id="@inputId" name="@inputName" type="@ContactFormFieldRules.InputType(definition)" class="@GetInputClass()"
                                       required="@definition.Required" maxlength="@ContactFormFieldRules.MaxLength(definition)"
                                       placeholder="@definition.Placeholder" value="@FieldValue(definition)"
                                       aria-describedby="@describedBy" aria-invalid="@invalid"
                                       @onchange="@(args => SetFieldValue(definition, args.Value))" />
                            }
                            @if (!string.IsNullOrWhiteSpace(definition.HelpText))
                            {
                                <p class="osirion-form-help" id="@FieldHelpId(definition)">@definition.HelpText</p>
                            }
                            @if (error is not null)
                            {
                                <div class="osirion-validation-message" id="@FieldErrorId(definition)">@error</div>
                            }
                        </div>
                    }
                }
                @if (TotalLengthError is { } totalLengthError)
                {
                    <div class="osirion-validation-message" id="@($"fields-error-{Id}")">@totalLengthError</div>
                }

                <!-- Privacy Policy Checkbox -->
                @if (!string.IsNullOrWhiteSpace(PrivacyPolicyText))
                {
                    <div class="osirion-form-group osirion-form-checkbox-group">
                        <label class="osirion-form-checkbox-label">
                            <InputCheckbox @bind-Value="FormModel.AgreeToPrivacyPolicy"
                                           class="@GetCheckboxClass()"
                                           aria-describedby="@($"privacy-error-{Id}")" />
                            <span class="osirion-checkbox-text">
                                @((MarkupString)PrivacyPolicyText)
                                @if (ShowRequiredIndicators)
                                {
                                    <span class="osirion-required">*</span>
                                }
                            </span>
                        </label>
                        <ValidationMessage For="@(() => FormModel.AgreeToPrivacyPolicy)" class="osirion-validation-message" id="@($"privacy-error-{Id}")" />
                    </div>
                }

                <!-- Subscribe to Updates Checkbox -->
                @if (ShowSubscribeOption)
                {
                    <div class="osirion-form-group osirion-form-checkbox-group">
                        <label class="osirion-form-checkbox-label">
                            <InputCheckbox @bind-Value="FormModel.SubscribeToUpdates"
                                           class="@GetCheckboxClass()" />
                            <span class="osirion-checkbox-text">@SubscribeText</span>
                        </label>
                    </div>
                }

                <!-- Submit Button -->
                <div class="osirion-form-actions">
                    <button type="submit"
                            class="@GetPrimaryButtonClass()">
                        <span>@SubmitButtonText</span>
                    </button>

                    @if (ShowResetButton)
                    {
                        <button type="reset"
                                class="@GetOutlinedPrimaryButtonClass()">
                            @ResetButtonText
                        </button>
                    }
                </div>
            </EditForm>
        </div>

        <!-- Contact Information Section -->
        @if (ShowContactInformation && ContactInfo != null)
        {
            <OsirionContactInfoSection Style="background-color: var(--osirion-background-secondary); padding: 1.5rem;" Title="@ContactInfoTitle"
                                       ContactInfo="@ContactInfo"
                                       AddressLabel="@ContactInfoAddressLabel"
                                       PhoneLabel="@ContactInfoPhoneLabel"
                                       EmailLabel="@ContactInfoEmailLabel"
                                       WebsiteLabel="@ContactInfoWebsiteLabel" />
        }
    </div>
</div>