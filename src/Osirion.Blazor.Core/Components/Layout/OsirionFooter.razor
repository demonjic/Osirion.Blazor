@namespace Osirion.Blazor.Components
@inherits OsirionComponentBase

@* Inside OsirionPageLayout's footer slot the layout already provides the contentinfo landmark, so a second
   <footer> would duplicate it; the same markup then renders in a <div>. *@
@{
    RenderFragment content = @<div class="osirion-footer-container">
        @if (ShowTopSection && HasTopContent)
        {
            <div class="osirion-footer-main">
                <div class="osirion-footer-main-left-content @(Logo is not null ? "osirion-footer-main-left-content-has-child" : "")">
                    @if (LeftContent is not null || Logo is not null || Description is not null)
                    {
                        @LeftContent

                        @if (Logo is not null || Description is not null)
                        {
                            <div class="osirion-footer-brand">
                                @if (Logo is not null)
                                {
                                    <div class="osirion-footer-logo">
                                        @Logo
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(Description))
                                {
                                    <p class="osirion-footer-description">@((MarkupString)Description)</p>
                                }
                            </div>
                        }
                    }

                </div>

                <div class="osirion-footer-main-middle-content">
                    <div class="osirion-footer-grid">


                        @if (Links?.Any() == true)
                        {
                            <div class="osirion-footer-links">
                                @foreach (var linkSection in Links)
                                {
                                    <div class="osirion-footer-section">
                                        @if (!string.IsNullOrWhiteSpace(linkSection.Title))
                                        {
                                            <h2 class="osirion-footer-section-title">@linkSection.Title</h2>
                                        }
                                        <ul class="osirion-footer-list">
                                            @foreach (var link in linkSection.Links)
                                            {
                                                <li class="osirion-footer-list-item">
                                                    <a href="@link.Href"
                                                       class="osirion-footer-link"
                                                       target="@(link.OpenInNewTab ? "_blank" : null)"
                                                       rel="@(link.OpenInNewTab ? "noopener noreferrer" : null)">
                                                        @link.Text
                                                    </a>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </div>
                        }

                        @if (SocialLinks?.Any() == true && ShowSocialLinks)
                        {
                            <div class="osirion-footer-social">
                                @if (!string.IsNullOrWhiteSpace(SocialTitle))
                                {
                                    <h2 class="osirion-footer-section-title">@SocialTitle</h2>
                                }
                                <div class="osirion-footer-social-links">
                                    @foreach (var social in SocialLinks)
                                    {
                                        <a href="@social.Href"
                                           class="osirion-footer-social-link"
                                           aria-label="@social.AriaLabel"
                                           target="_blank"
                                           rel="noopener noreferrer">
                                            @if (social.Icon is not null)
                                            {
                                                @social.Icon
                                            }
                                            else
                                            {
                                                <span>@social.Text</span>
                                            }
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="osirion-footer-main-right-content">
                    @if (RightContent is not null)
                    {
                        @RightContent
                    }
                </div>
            </div>
        }

        @if (ShowDivider && ShowTopSection && ShowBottomSection)
        {
            <div class="osirion-footer-divider"></div>
        }

        @if (ShowBottomSection)
        {
            <div class="osirion-footer-bottom">
                <div class="osirion-footer-bottom-content">
                    @if (!string.IsNullOrWhiteSpace(Copyright))
                    {
                        <div class="osirion-footer-copyright">
                            @((MarkupString)Copyright)
                        </div>
                    }
                    else if (ShowCopyright)
                    {
                        <div class="osirion-footer-copyright">
                            &copy; @DateTime.Now.Year <a class="osirion-footer-bottom-link" href="@CompanyUrl" target="@(CompanyIsExternal ? "_blank" : "_self")" rel="@(CompanyIsExternal ? "noopener noreferrer" : null)">@CompanyName</a>. All rights reserved.
                        </div>
                    }
                </div>

                @if (BottomLinks?.Any() == true)
                {
                    <nav class="osirion-footer-bottom-links" aria-label="Footer legal navigation">
                        @foreach (var link in BottomLinks)
                        {
                            <a href="@link.Href" class="osirion-footer-bottom-link">
                                @link.Text
                            </a>
                        }
                    </nav>
                }
            </div>
        }

        @if (ChildContent is not null)
        {
            <div class="osirion-footer-extra">
                <div class="osirion-footer-bottom-content">
                    @ChildContent
                </div>
            </div>
        }
    </div>;
}

@if (InsidePageLayoutFooter)
{
    <div class="@GetFooterClass()" style="@Style" data-osirion-component-theme="@GetComponentTheme()" @attributes="Attributes">@content</div>
}
else
{
    <footer class="@GetFooterClass()" style="@Style" data-osirion-component-theme="@GetComponentTheme()" @attributes="Attributes">@content</footer>
}