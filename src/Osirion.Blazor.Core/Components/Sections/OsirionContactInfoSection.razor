@namespace Osirion.Blazor.Components
@inherits OsirionComponentBase
@using Osirion.Blazor.Core.Models

<div class="@GetContactInfoSectionClass()" style="@Style" @attributes="Attributes">
    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <h2 class="osirion-contact-info-title">@Sanitized(Title)</h2>
    }

    @if (!string.IsNullOrWhiteSpace(ContactInfo?.Message))
    {
        <p class="osirion-contact-info-description">@Sanitized(ContactInfo.Message)</p>
    }

    <div class="osirion-contact-info-list">
        @if (!string.IsNullOrWhiteSpace(ContactInfo?.Address))
        {
            <div class="osirion-contact-info-item">
                <div class="osirion-contact-info-icon">
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="@IconPath(ContactInfoIcon.Address)"></path>
                    </svg>
                </div>
                <div class="osirion-contact-info-content">
                    <span class="osirion-contact-info-label">@AddressLabel</span>
                    <span class="osirion-contact-info-value">@Sanitized(ContactInfo.Address)</span>
                </div>
            </div>
        }

        @if (Phones().Any())
        {
            <div class="osirion-contact-info-item">
                <div class="osirion-contact-info-icon">
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="@IconPath(ContactInfoIcon.Phone)"></path>
                    </svg>
                </div>
                <div class="osirion-contact-info-content">
                    <span class="osirion-contact-info-label">@PhoneLabel</span>
                    @foreach (var phone in Phones())
                    {
                        <a href="tel:@phone" class="osirion-contact-info-value osirion-contact-link">@phone</a>
                    }
                </div>
            </div>
        }

        @if (Emails().Any())
        {
            <div class="osirion-contact-info-item">
                <div class="osirion-contact-info-icon">
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="@IconPath(ContactInfoIcon.Email)"></path>
                    </svg>
                </div>
                <div class="osirion-contact-info-content">
                    <span class="osirion-contact-info-label">@EmailLabel</span>
                    @foreach (var email in Emails())
                    {
                        <a href="mailto:@email" class="osirion-contact-info-value osirion-contact-link">@email</a>
                    }
                </div>
            </div>
        }

        @if (_websiteLinks.Count > 0)
        {
            <div class="osirion-contact-info-item">
                <div class="osirion-contact-info-icon">
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="@IconPath(ContactInfoIcon.Website)"></path>
                    </svg>
                </div>
                <div class="osirion-contact-info-content">
                    <span class="osirion-contact-info-label">@WebsiteLabel</span>
                    @foreach (var website in _websiteLinks)
                    {
                        <a href="@website.Href" target="@website.Target" rel="noopener noreferrer" class="osirion-contact-info-value osirion-contact-link">@website.DisplayText</a>
                    }
                </div>
            </div>
        }

        @foreach (var item in AdditionalItems)
        {
            <div class="osirion-contact-info-item">
                <div class="osirion-contact-info-icon">
                    @if (IconPath(item.Icon) is { } iconPath)
                    {
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="@iconPath"></path>
                        </svg>
                    }
                </div>
                <div class="osirion-contact-info-content">
                    <span class="osirion-contact-info-label">@item.Label</span>
                    @if (HasSafeHref(item))
                    {
                        <a href="@item.Href" target="@ItemTarget(item)" rel="@ItemRel(item)" class="osirion-contact-info-value osirion-contact-link">@item.Text</a>
                    }
                    else
                    {
                        <span class="osirion-contact-info-value">@item.Text</span>
                    }
                </div>
            </div>
        }
    </div>
</div>