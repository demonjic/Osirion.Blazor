@namespace Osirion.Blazor.Components
@inherits OsirionComponentBase
@using Osirion.Blazor.Core.Utils

@if (Plans.Count > 0)
{
    <ul class="@GetPricingTableClass()" role="list" @attributes="Attributes">
        @foreach (var plan in Plans)
        {
            <li @key="plan.Name" class="@GetPlanClass(plan)">
                @if (!string.IsNullOrWhiteSpace(plan.Badge))
                {
                    <p class="osirion-pricing-badge">@plan.Badge</p>
                }

                @switch (NameHeadingLevel)
                {
                    case null:
                        <p class="osirion-pricing-name">@plan.Name</p>
                        break;
                    case 2:
                        <h2 class="osirion-pricing-name">@plan.Name</h2>
                        break;
                    case 3:
                        <h3 class="osirion-pricing-name">@plan.Name</h3>
                        break;
                    case 4:
                        <h4 class="osirion-pricing-name">@plan.Name</h4>
                        break;
                    case 5:
                        <h5 class="osirion-pricing-name">@plan.Name</h5>
                        break;
                    case 6:
                        <h6 class="osirion-pricing-name">@plan.Name</h6>
                        break;
                    default:
                        <h1 class="osirion-pricing-name">@plan.Name</h1>
                        break;
                }

                @if (!string.IsNullOrWhiteSpace(plan.Price))
                {
                    <p class="osirion-pricing-price">
                        <span class="osirion-pricing-amount">@plan.Price</span>
                        @if (!string.IsNullOrWhiteSpace(plan.Period))
                        {
                            <span class="osirion-pricing-period">@plan.Period</span>
                        }
                    </p>
                }

                @if (!string.IsNullOrWhiteSpace(plan.Description))
                {
                    <p class="osirion-pricing-description">@plan.Description</p>
                }

                @if (plan.Features.Count > 0)
                {
                    <ul class="osirion-pricing-features">
                        @foreach (var feature in plan.Features)
                        {
                            <li>@feature</li>
                        }
                    </ul>
                }

                @if (!string.IsNullOrWhiteSpace(plan.CallToActionText) && SafeLink.IsSafe(plan.CallToActionUrl))
                {
                    <a class="osirion-pricing-action @(plan.Highlighted ? GetPrimaryButtonClass() : GetSecondaryButtonClass())"
                       href="@plan.CallToActionUrl"
                       aria-label="@($"{plan.CallToActionText}: {plan.Name}")">@plan.CallToActionText</a>
                }
            </li>
        }
    </ul>
}
