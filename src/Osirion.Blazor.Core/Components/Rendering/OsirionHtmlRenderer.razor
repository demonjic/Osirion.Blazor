@namespace Osirion.Blazor.Components
@inherits OsirionComponentBase
@using BlazorJSComponents

@if (!string.IsNullOrWhiteSpace(HtmlContent))
{
    <link rel="stylesheet" href="@Assets["_content/Osirion.Blazor.Core/css/osirion-html-renderer.min.css"]" />

    @* A class, not an id: several renderers can share a page and an id would repeat. *@
    <div class="osirion-syntax-highlighter-config"
         data-enable-copy="@EnableCopyButton.ToString().ToLower()"
         data-enable-line-highlighting="@EnableLineHighlighting.ToString().ToLower()"
         data-show-line-numbers="@ShowLineNumbers.ToString().ToLower()"
         hidden>
    </div>

    @if (HasCodeBlocks && EnableSyntaxHighlighting)
    {

        @if (!UseAccessibleTheme)
        {
            <link rel="stylesheet" href="@PrismUrl("themes/prism-okaidia.min.css")" integrity="@PrismIntegrity("themes/prism-okaidia.min.css")" crossorigin="@PrismCrossOrigin("themes/prism-okaidia.min.css")" />
        }
        else
        {
            <style>
                @((MarkupString)GetAccessibleThemeCss())
            </style>
        }

        @if (ShowLineNumbers)
        {
            <link rel="stylesheet" href="@PrismUrl("plugins/line-numbers/prism-line-numbers.min.css")" integrity="@PrismIntegrity("plugins/line-numbers/prism-line-numbers.min.css")" crossorigin="@PrismCrossOrigin("plugins/line-numbers/prism-line-numbers.min.css")" />
        }

        @* Prism and its plugins load through a loader that can enforce Subresource Integrity (the generic JS component cannot). *@
        <JS Src="./_content/Osirion.Blazor.Core/js/osirion-script-loader.js" Args="@(new object[] { GetPrismScripts() })" />

        @LoadScript("./_content/Osirion.Blazor.Core/js/osirion-syntax-highlighter.es5.min.js")
        @LoadScript("./_content/Osirion.Blazor.Core/js/osirion-copy-button.es5.min.js")
        @LoadScript("./_content/Osirion.Blazor.Core/js/osirion-line-highlighting.es5.min.js")
    }

    <article class="@GetHtmlRendererClass()" @attributes="Attributes">
        @if (Segments is null)
        {
            @((MarkupString)ProcessedHtml)
        }
        else
        {
            @foreach (var segment in Segments)
            {
                @if (segment.Demo is null)
                {
                    @((MarkupString)segment.Html!)
                }
                else
                {
                    <OsirionContentDemo Demo="segment.Demo" EnableCopyButton="EnableCopyButton" />
                }
            }
        }
    </article>
}
