@namespace Osirion.Blazor.Components
@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Components.Forms
@using Osirion.Blazor.Core.Utils
@inherits OsirionComponentBase
@inject NavigationManager Navigation

@* The same banner in both modes: in a form the server answers, or in an element the consent script shows. *@
@{
    @* A named region, so the banner is not content outside every landmark (axe "region") *@
    RenderFragment banner = @<div class="@GetCookieConsentClass()" role="region" aria-label="@Title">
            <div class="osirion-cookie-consent-container">
                <div class="osirion-cookie-consent-content">
                    <div class="osirion-cookie-consent-message">
                        @if (Icon is not null)
                        {
                            <div class="osirion-cookie-consent-icon">
                                @Icon
                            </div>
                        }
                        <div class="osirion-cookie-consent-text">
                            <h3 class="osirion-cookie-consent-title">@Title</h3>
                            <p class="osirion-cookie-consent-description">
                                @Message
                                @if (!string.IsNullOrWhiteSpace(PolicyLink))
                                {
                                    @* Razor drops the whitespace before a code block, so the space is written explicitly *@
                                    @(" ")<a href="@PolicyLink" class="osirion-cookie-consent-link">@PolicyLinkText</a>
                                }
                            </p>
                        </div>
                    </div>

                    <div class="osirion-cookie-consent-actions">
                        @if (ShowDeclineButton)
                        {
                            <button type="@ButtonType"
                                    name="consent"
                                    value="declined"
                                    class="@GetDangerButtonClass()">
                                @DeclineButtonText
                            </button>
                        }

                        @if (ShowCustomizeChoice)
                        {
                            <button type="@ButtonType"
                                    name="consent"
                                    value="customize"
                                    class="@BuildButtonClass(variant: ButtonVariant.OutlinedPrimary) osirion-cookie-consent-customize-button"
                                    aria-expanded="@CustomizeExpanded">
                                @CustomizeButtonText
                            </button>
                        }

                        <button type="@ButtonType"
                                name="consent"
                                value="accepted"
                                class="@GetPrimaryButtonClass()">
                            @AcceptButtonText
                        </button>
                    </div>
                </div>

                @if (RenderCustomizationPanel)
                {
                    <div class="osirion-cookie-consent-customize" hidden="@EvaluatedInBrowser">
                        <h4 class="osirion-cookie-consent-customize-title">@CustomizePanelTitle</h4>

                        <div class="osirion-cookie-consent-categories">
                            @foreach (var category in Categories)
                            {
                                <div class="osirion-cookie-consent-category">
                                    <label class="osirion-cookie-consent-category-label">
                                        <input type="checkbox"
                                               name="category_@category.Id"
                                               value="true"
                                               checked="@IsChecked(category)"
                                               disabled="@category.IsRequired"
                                               class="@GetCheckboxClass()" />
                                        <div class="osirion-cookie-consent-category-info">
                                            <span class="osirion-cookie-consent-category-name">
                                                @category.Name
                                                @if (category.IsRequired)
                                                {
                                                    <span class="osirion-cookie-consent-required"> (Required)</span>
                                                }
                                            </span>
                                            <p class="osirion-cookie-consent-category-description">@category.Description</p>
                                        </div>
                                    </label>
                                </div>
                            }
                        </div>

                        <div class="osirion-cookie-consent-customize-actions">
                            <button type="@ButtonType"
                                    name="consent"
                                    value="save-preferences"
                                    class="@GetOutlinedPrimaryButtonClass()">
                                @SavePreferencesButtonText
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>;
}

@if (EvaluatedInBrowser)
{
    @* No form and no request data: the page is the same for every visitor, and the consent script decides. *@
    <div class="osirion-cookie-consent-form" hidden data-osirion-consent-banner data-osirion-consent-days="@BrowserExpiryDays" @attributes="Attributes">
        @banner
    </div>
    @LoadScript(ConsentScripts.ModulePath)
}
else if (ShowBanner)
{
    <form method="post" action="@ConsentEndpoint" class="osirion-cookie-consent-form" @attributes="Attributes">
        <AntiforgeryToken />
        <input type="hidden" name="expiryDays" value="@ConsentExpiryDays" />
        <input type="hidden" name="returnUrl" value="@GetCurrentUrl()" />
        @banner
    </form>
}