@namespace Osirion.Blazor.Navigation.Components
@inherits OsirionComponentBase

<div class="@_containerClass" data-osirion-component-theme="@GetComponentTheme()" @attributes="_containerAttributes">
    <nav class="osirion-menu-nav" id="@NavId" aria-label="@AriaLabel">
        <div class="osirion-nav-branding">
            @if (BrandingTemplate is not null)
            {
                @BrandingTemplate
            }
            else if (!string.IsNullOrWhiteSpace(BrandLogo))
            {
                <a href="@RenderedHref" class="osirion-brand-link">
                    <img src="@BrandLogo" alt="@LogoAlt" class="osirion-brand-logo" width="36" height="36" />
                    @if (!string.IsNullOrWhiteSpace(BrandText))
                    {
                        <span class="osirion-brand-text">@BrandText</span>
                    }
                </a>
            }
            else if (!string.IsNullOrWhiteSpace(BrandText))
            {
                <a class="osirion-brand-link osirion-brand-text" href="@RenderedHref">@BrandText</a>
            }
        </div>

        @* Mobile toggle: a visually hidden but focusable checkbox (keyboard and CSS-only, no JavaScript), labelled by the
           visible hamburger. It follows the brand and precedes the drawer it opens, so the keyboard meets the brand
           first and the next Tab after opening the drawer lands on its items. *@
        @if (CollapseOnMobile)
        {
            <input type="checkbox" id="@ToggleId" class="osirion-navbar-toggler" aria-label="@ToggleAriaLabel" aria-controls="@DrawerId" />
            <label for="@ToggleId" class="osirion-navbar-toggle">
                <span class="osirion-toggle-icon"></span>
            </label>
            @* Dims the page behind the open drawer; a tap on it closes the drawer. *@
            <label for="@ToggleId" class="osirion-menu-backdrop" aria-hidden="true"></label>
        }

        <div class="osirion-menu" id="@DrawerId">
            <div class="osirion-menu-inner">
                @ChildContent
            </div>
            @if (Actions is not null)
            {
                <div class="osirion-menu-actions">
                    @Actions
                </div>
            }
        </div>

        @if (PinnedActions is not null)
        {
            <div class="osirion-menu-pinned-actions">
                @PinnedActions
            </div>
        }
    </nav>
</div>
