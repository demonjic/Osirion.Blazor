@namespace Osirion.Blazor.Navigation.Components
@inherits OsirionComponentBase

<div class="@WrapperCssClass" style="@Style" @attributes="Attributes">
    @if (HasSubmenu)
    {
        @* Disclosure toggle: a visually hidden but focusable checkbox, so the submenu opens from the keyboard
           and without JavaScript. Its checked state is the expanded state. *@
        <input type="checkbox" class="osirion-submenu-toggler" id="@SubmenuToggleId" aria-controls="@SubmenuId" aria-label="@SubmenuToggleLabel" />
    }
    @if (_isToggleOnly)
    {
        @* A parent with no destination of its own opens its submenu instead of following a dead "#" link. *@
        <label for="@SubmenuToggleId" class="osirion-menu-item osirion-menu-item-toggle-only @(_isActive ? "osirion-menu-item-active" : "") @Class">
            @ItemContent
        </label>
    }
    else
    {
        <a href="@_renderedHref"
           target="@RenderedTarget"
           rel="@RenderedRel"
           class="@LinkCssClass"
           @onclick="OnClickHandler"
           role="@LinkRole"
           aria-disabled="@AriaDisabled"
           aria-current="@AriaCurrent">
            @ItemContent
        </a>
    }
    @if (HasSubmenu)
    {
        @* No aria-label here: ARIA prohibits naming a <label> element; the
           associated checkbox (osirion-submenu-toggler) carries the accessible name. *@
        <label for="@SubmenuToggleId" class="osirion-submenu-toggle">
            <span class="osirion-menu-item-chevron" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="9 18 15 12 9 6" />
                </svg>
            </span>
        </label>
        <div class="osirion-submenu compact-submenu @SubmenuVariantClass" id="@SubmenuId">
            @if (SubmenuVariant == SubmenuVariant.Mega)
            {
                <div class="osirion-submenu-mega-content">
                    @ChildContent
                </div>
                @if (SubmenuAside is not null)
                {
                    <div class="osirion-submenu-mega-aside">
                        @SubmenuAside
                    </div>
                }
            }
            else
            {
                @ChildContent
            }
        </div>
    }
</div>

@code {
    // The icon and text of the item, shared by the link and by the label of a parent that only toggles its submenu.
    // A name without a built-in icon renders no icon slot, so the text is not indented.
    private RenderFragment ItemContent => @<text>
    @if (IconTemplate is not null)
    {
        <span class="osirion-menu-item-icon">@IconTemplate</span>
    }
    else if (BuiltInIconPaths is { } iconPaths)
    {
        <span class="osirion-menu-item-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                @foreach (var iconPath in iconPaths)
                {
                    <path fill-rule="@iconPath.FillRule" d="@iconPath.Data" />
                }
            </svg>
        </span>
    }
    <span class="osirion-menu-item-content">
        <span class="osirion-menu-item-text">@Text</span>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <span class="osirion-menu-item-description">@Description</span>
        }
    </span>
    </text>;
}
