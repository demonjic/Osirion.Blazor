@namespace Osirion.Blazor.Navigation.Components
@inherits OsirionComponentBase

@if (_links.Count > 1)
{
    RenderFragment list = @<ul class="osirion-language-picker-list">
        @foreach (var link in _links)
        {
            <li class="osirion-language-picker-item" @key="link.Name">
                <a class="osirion-language-picker-link"
                   href="@link.Href"
                   hreflang="@link.Name"
                   lang="@link.Name"
                   aria-current="@(link.IsCurrent ? "true" : null)">@link.DisplayName</a>
            </li>
        }
    </ul>;

    <nav class="@CombineCssClasses(NavClass)" aria-label="@AriaLabel" style="@Style" @attributes="Attributes">
        @if (Compact)
        {
            <details class="osirion-language-picker-disclosure">
                <summary class="osirion-language-picker-summary"><span lang="@CurrentLink.Name">@CurrentLink.DisplayName</span></summary>
                @list
            </details>
        }
        else
        {
            @list
        }
    </nav>
}
