<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Osirion.Blazor" Version="4.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Markdown files are read from this folder at run time, so publishing copies it next to the application. -->
    <Content Include="content\**" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
