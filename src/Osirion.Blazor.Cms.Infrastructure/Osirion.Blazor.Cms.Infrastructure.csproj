<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<!-- NuGet package properties -->
		<PackageId>Osirion.Blazor.Cms.Infrastructure</PackageId>
		<Version>4.4.0</Version>
		<Description>Infrastructure layer for the Osirion.Blazor CMS ecosystem, implementing repositories, external service integrations, and infrastructure concerns.</Description>
		<PackageTags>blazor;components;content;cms;infrastructure;github;filesystem;osirion</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="wwwroot\**" />
		<Content Remove="wwwroot\**" />
		<EmbeddedResource Remove="wwwroot\**" />
		<None Remove="wwwroot\**" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Osirion.Blazor.Cms.Application\Osirion.Blazor.Cms.Application.csproj" />
		<ProjectReference Include="..\Osirion.Blazor.Cms.Domain\Osirion.Blazor.Cms.Domain.csproj" />
		<ProjectReference Include="..\Osirion.Blazor.Core\Osirion.Blazor.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Blazored.LocalStorage" />
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<PackageReference Include="Octokit" />
		<PackageReference Include="Scrutor" />
		<PackageReference Include="System.IO.Abstractions" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Osirion.Blazor.Cms.Infrastructure.Tests" />
		<!-- Cms.Admin registers the scoped admin service through the same internal helper, so both packages keep one
		     lifetime rule and one cookie policy for the GitHub HTTP clients -->
		<InternalsVisibleTo Include="Osirion.Blazor.Cms.Admin" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>