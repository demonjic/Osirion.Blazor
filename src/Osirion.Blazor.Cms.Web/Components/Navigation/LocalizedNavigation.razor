@namespace Osirion.Blazor.Cms.Web.Components

<nav class="@GetNavClass()" aria-label="@AriaLabel">
    @if (Title is not null)
    {
        <h3 class="osirion-nav-title">@Title</h3>
    }

    @if (IsLoading)
    {
        <div class="osirion-loading">@LoadingText</div>
    }
    else if (Directories is null || !Directories.Any())
    {
        <div class="osirion-no-directories">@NoContentText</div>
    }
    else
    {
        @if (ShowLocaleSelector)
        {
            <div class="osirion-locale-selector">
                @foreach (var locale in AvailableLocales)
                {
                    var localeCode = locale.Code;
                    @* A handler is written only with a callback, so without one the link navigates in every render mode. *@
                    if (OnLocaleChanged.HasDelegate)
                    {
                        <a href="@GetLocaleUrl(localeCode)" hreflang="@localeCode" class="@GetLocaleButtonClass(localeCode)" aria-current="@GetLocaleAriaCurrent(localeCode)"
                           @onclick="() => SwitchLocale(localeCode)" @onclick:preventDefault="true">@GetLocaleName(locale)</a>
                    }
                    else
                    {
                        <a href="@GetLocaleUrl(localeCode)" hreflang="@localeCode" class="@GetLocaleButtonClass(localeCode)" aria-current="@GetLocaleAriaCurrent(localeCode)">@GetLocaleName(locale)</a>
                    }
                }
            </div>
        }

        <ul class="osirion-nav-list">
            @RenderDirectories(Directories)
        </ul>
    }
</nav>