@namespace Osirion.Blazor.Cms.Web.Components
@using BlazorJSComponents
@attribute [DiscoverCollocatedJS]
@inject JSElementReferenceScope Refs

@if (HasAnythingToShow)
{
    <nav class="@GetTableOfContentsClass()" aria-label="Table of Contents" data-ref="@Refs["nav"]">
        @if (Headings.Any())
        {
            <ol class="osirion-toc-list">
                @foreach (var heading in Headings)
                {
                    <li class="osirion-toc-item osirion-toc-level-@heading.Level">
                        <a href="@CurrentUrl#@heading.Id" class="osirion-toc-link">@heading.Text</a>
                        @if (heading.Children.Any())
                        {
                            <ol class="osirion-toc-sublist">
                                @foreach (var child in heading.Children)
                                {
                                    <li class="osirion-toc-item osirion-toc-level-@child.Level">
                                        <a href="@CurrentUrl#@child.Id" class="osirion-toc-link">@child.Text</a>
                                    </li>
                                }
                            </ol>
                        }
                    </li>
                }
            </ol>
        }
        else
        {
            <p class="osirion-toc-empty">@EmptyText</p>
        }
    </nav>
}

@if (Headings.Any() && TrackActiveHeading)
{
    <JS Src="./_content/Osirion.Blazor.Cms.Web/Components/Navigation/TableOfContents.razor.js" Args="[Refs]" />
}