@namespace Osirion.Blazor.Cms.Components
@using Osirion.Blazor.Cms.Web.Components
@inherits OsirionContentDetailPageBase

<div class="@GetDocumentPageClass()" style="@Style" @attributes="Attributes">
    @if (IsLoading)
    {
        <OsirionPageLoading ShowText="ShowLoadingText" Text="@LoadingText" />
    }
    else if (Content is null && !string.IsNullOrWhiteSpace(ContentPath))
    {
        @RenderNotFound
    }
    else
    {
        @if (Content is not null)
        {
            <HeadContent>
                <SeoMetadataRenderer Content="Content"
                                     SiteNameOverride="@WebsiteName"
                                     OrganizationName="@OrganizationName"
                                     SiteLogoUrl="@SiteLogoUrl"
                                     SchemaTypes="@(SchemaTypes ?? DefaultSchemaTypes)"
                                     GenerateMultipleSchemas="@GenerateMultipleSchemas"
                                     PrevPageUrl="@PrevPageUrl"
                                     NextPageUrl="@NextPageUrl"
                                     AlternateLanguageUrls="@AlternateLanguageUrls"
                                     @attributes="SeoRendererParameters" />
            </HeadContent>
        }

        <div class="osirion-document-layout">
            @if (ShowSideNavigation)
            {
                <nav class="osirion-document-sidenav" aria-label="Document navigation">
                    @* On narrow screens the list folds behind this toggle, so the page starts with its content: a
                       visually hidden but focusable checkbox, labelled by the visible button. No script. *@
                    <input type="checkbox" id="@SideNavigationToggleId" class="osirion-sidenav-toggler" aria-controls="@SideNavigationPanelId" />
                    <label for="@SideNavigationToggleId" class="osirion-sidenav-toggle">@SideNavigationToggleText</label>

                    <div id="@SideNavigationPanelId" class="osirion-sidenav-panel">
                        @if (!string.IsNullOrWhiteSpace(NavigationTitle))
                        {
                            <h2 class="osirion-sidenav-title">@NavigationTitle</h2>
                        }

                        @if (SideNavigationItems is { Count: > 0 } sideNavigationItems)
                        {
                            <ul class="osirion-sidenav-list">
                                @foreach (var item in sideNavigationItems)
                                {
                                    <li class="osirion-sidenav-item">
                                        <a href="@GetNavigationUrl(item)"
                                           class="@GetNavigationLinkClass(item)"
                                           aria-current="@(IsCurrentPage(item) ? "page" : null)">
                                            @item.Title
                                        </a>
                                        @if (item.Children is not null && item.Children.Any() && (item.IsExpanded || IsParentOfCurrentPage(item)))
                                        {
                                            <ul class="osirion-sidenav-sublist">
                                                @foreach (var child in item.Children)
                                                {
                                                    <li class="osirion-sidenav-item">
                                                        <a href="@GetNavigationUrl(child)"
                                                           class="@GetNavigationLinkClass(child)"
                                                           aria-current="@(IsCurrentPage(child) ? "page" : null)">
                                                            @child.Title
                                                        </a>
                                                    </li>
                                                }
                                            </ul>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </nav>
            }

            <div class="osirion-document-main">
                @if (ShowBreadcrumbs)
                {
                    <ContentBreadcrumbs Content="@Content"
                                        Directory="@Content?.Directory"
                                        ShowHome="@ShowBreadcrumbHome"
                                        HomeUrl="@BreadcrumbHomeUrl"
                                        HomeText="@BreadcrumbHomeText"
                                        DirectoryUrlFormatter="@DirectoryUrlFormatter" />
                }

                @if (Content is not null)
                {
                    <article class="osirion-document-content" itemscope itemtype="https://schema.org/@GetItemType()">
                        <header class="osirion-document-header">
                            <h1 class="osirion-document-title">@Content.Title</h1>
                            @if (ShowMetadata)
                            {
                                <div class="osirion-document-meta">
                                    @if (!string.IsNullOrWhiteSpace(Content.Author))
                                    {
                                        <span class="osirion-document-author">
                                            <svg class="osirion-meta-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                                <circle cx="12" cy="7" r="4"></circle>
                                            </svg>
                                            @Content.Author
                                        </span>
                                    }
                                    <span class="osirion-document-date">
                                        <svg class="osirion-meta-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                            <line x1="16" y1="2" x2="16" y2="6"></line>
                                            <line x1="8" y1="2" x2="8" y2="6"></line>
                                            <line x1="3" y1="10" x2="21" y2="10"></line>
                                        </svg>
                                        @{ var lastUpdated = Content.LastModified ?? Content.PublishDate; }
                                        <span>@LastUpdatedText <time datetime="@ContentDates.MachineReadable(lastUpdated)">@ContentDates.Format(lastUpdated, "MMMM d, yyyy", Content)</time></span>
                                    </span>
                                </div>
                            }
                        </header>

                        @if (ShowTableOfContents)
                        {
                            <aside class="osirion-document-toc">
                                <h2 class="osirion-toc-title">@TableOfContentsTitle</h2>
                                <TableOfContents Content="@Content.Content" MinLevel="@TocMinLevel" MaxLevel="@TocMaxLevel" ShowNumbers="@TocShowNumbers" />
                            </aside>
                        }

                        <div class="osirion-document-body">
                            @* Through OsirionHtmlRenderer, as ArticlePage does: sanitised, highlighted, and with code
                               blocks and tables that scroll and can be reached from the keyboard. *@
                            <ContentRenderer Item="@Content" OmitLeadingTitle="true" />
                        </div>

                        @if (EditUrlFormatter?.Invoke(Content) is { Length: > 0 } editUrl)
                        {
                            <p class="osirion-document-edit">
                                <a href="@editUrl" rel="noopener" target="_blank">@EditLinkText</a>
                            </p>
                        }

                        @if (ShowNavigationLinks && (PreviousItem is not null || NextItem is not null))
                        {
                            <nav class="osirion-document-pagination" aria-label="Document pagination">
                                @if (PreviousItem is not null)
                                {
                                    <a href="@GetContentUrl(PreviousItem)" class="osirion-doc-nav-previous">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="15 18 9 12 15 6"></polyline>
                                        </svg>
                                        <div class="osirion-doc-nav-text">
                                            <span class="osirion-doc-nav-label">Previous</span>
                                            <span class="osirion-doc-nav-title">@PreviousItem.Title</span>
                                        </div>
                                    </a>
                                }

                                @if (NextItem is not null)
                                {
                                    <a href="@GetContentUrl(NextItem)" class="osirion-doc-nav-next">
                                        <div class="osirion-doc-nav-text">
                                            <span class="osirion-doc-nav-label">Next</span>
                                            <span class="osirion-doc-nav-title">@NextItem.Title</span>
                                        </div>
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="9 18 15 12 9 6"></polyline>
                                        </svg>
                                    </a>
                                }
                            </nav>
                        }
                    </article>
                }

                @if (!string.IsNullOrWhiteSpace(CustomFooterContent))
                {
                    <ContentSection Content="@CustomFooterContent"
                                    Variant="highlight"
                                    Padding="normal" />
                }
            </div>
        </div>
    }
</div>