@namespace Osirion.Blazor.Cms.Web.Components
@using Osirion.Blazor.Cms.Components
@inherits OsirionContentDetailPageBase

<div class="@GetArticlePageClass()" style="@Style" @attributes="Attributes">
    @if (IsLoading)
    {
        <OsirionPageLoading ShowText="ShowLoadingText" Text="@LoadingText" />
    }
    else if (Item is null)
    {
        @RenderNotFound
    }
    else if (Item is not null)
    {
        <HeadContent>
            <SeoMetadataRenderer Content="Item" 
                                 SiteNameOverride="@WebsiteName" 
                                 SchemaTypes="@SchemaTypes"
                                 CustomBreadcrumbs="@CustomBreadcrumbs"
                                 PrevPageUrl="@PrevPageUrl"
                                 NextPageUrl="@NextPageUrl"
                                 AlternateLanguageUrls="@AlternateLanguageUrls"
                                 OrganizationName="@OrganizationName"
                                 SiteLogoUrl="@SiteLogoUrl"
                                 GenerateMultipleSchemas="@GenerateMultipleSchemas"
                                 @attributes="SeoRendererParameters" />
        </HeadContent>

        @if (HeaderContent is not null)
        {
            <header class="osirion-article-header">@HeaderContent(Item!)</header>
        }
        else if (ShowHero)
        {
            <HeroSection Title="@Item?.Title"
                         Subtitle="@Item?.Description"
                         BackgroundPattern="HeroBackgroundPattern"
                         Theme="HeroTheme"
                         UseBackgroundImage="UseHeroBackgroundImage"
                         HasOverlay="HasOverlay"
                         ImageUrl="@(HeroImageUrl ?? Item?.FeaturedImageUrl)"
                         ImageAlt="@Item?.Title"
                         ImagePosition="HeroImagePosition"
                         Alignment="HeroAlignment"
                         Variant="HeroVariant"
                         PrimaryButtonText="@HeroPrimaryButtonText"
                         PrimaryButtonUrl="@HeroPrimaryButtonUrl"
                         SecondaryButtonText="@HeroSecondaryButtonText"
                         SecondaryButtonUrl="@HeroSecondaryButtonUrl"
                         HasDivider="false"
                         ShowMetadata
                         Author="@Item?.Author"
                         PublishDate="@(Item?.PublishDate ?? @Item?.DateCreated)"
                         Culture="@ContentDates.CultureOf(Item)"
                         ReadTime="@Item?.ReadTimeMinutes.ToString()" />
        }

        <div class="osirion-article-page-content">

            @if (ShowBreadcrumbs)
            {
                <OsirionBreadcrumbs Path="@Item?.Url"
                                    CurrentPageText="@Item?.Title"
                                    ShowHome="@ShowBreadcrumbHome"
                                    HomeUrl="@BreadcrumbHomeUrl"
                                    HomeText="@BreadcrumbHomeText" />
            }

            <div class="osirion-article-layout @(ShowSidebar ? "osirion-article-layout-with-sidebar" : "")">
                <!-- Main content area -->
                <div class="osirion-article-main">
                    @if (ShowSeriesNavigation)
                    {
                        <ContentSeriesNavigation Item="@Item" ContentUrlFormatter="@ItemUrlFormatter" />
                    }

                    <ContentRenderer Item="@Item" OmitLeadingTitle="@(ShowHero || HeaderContent is not null)" />

                    @if (AuthorContent is not null)
                    {
                        <div class="osirion-article-author">
                            @AuthorContent(Item!)
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(CustomFooterContent))
                    {
                        <div class="osirion-article-footer">
                            <OsirionHtmlRenderer HtmlContent="@CustomFooterContent" />
                        </div>
                    }

                    @if (ShowNavigation)
                    {
                        <OsirionContentNavigation Item="Item" ShowDescription ShowPlaceholder />
                    }

                    @* With nothing related, the section would render the list's "not found" block inside the article *@
                    @if (ShowRelatedContent && RelatedItems is { Count: > 0 })
                    {
                        <OsirionContentListSection Title="@RelatedContentTitle" Items="RelatedItems" Layout="grid" PostCount="10" Columns="2" />
                    }
                </div>

                <!-- Right sidebar - Author, Categories, Tags -->
                @if (ShowSidebar)
                {
                    <OsirionStickySidebar>
                        @if (ShowTableOfContents)
                        {
                            <div class="osirion-sidebar-section osirion-toc">
                                <h2 class="osirion-sidebar-title">@TableOfContentsTitle</h2>
                                <TableOfContents Content="@Item?.Content" />
                            </div>
                        }

                        @if (ShowCategoriesSidebar && Item!.Categories.Any())
                        {
                            <div class="osirion-sidebar-section">
                                <h2 class="osirion-sidebar-title">@CategoriesSectionTitle</h2>
                                <div class="osirion-sidebar-categories">
                                    @foreach (var category in Item.Categories)
                                    {
                                        <a href="@GetCategoryUrl(category)" class="osirion-sidebar-category">
                                            <i class="osirion-icon-folder"></i> @category
                                        </a>
                                    }
                                </div>
                            </div>
                        }

                        @if (ShowTagsSidebar && Item!.Tags.Any())
                        {
                            <div class="osirion-sidebar-section">
                                <h2 class="osirion-sidebar-title">@TagsSectionTitle</h2>
                                <div class="osirion-sidebar-tags">
                                    @foreach (var tag in Item.Tags)
                                    {
                                        <a href="@GetTagUrl(tag)" class="osirion-sidebar-tag @GetTagBadgeClass(tag)">@tag</a>
                                    }
                                </div>
                            </div>
                        }

                        @if (SidebarContent is not null)
                        {
                            <div class="osirion-sidebar-section osirion-sidebar-custom">
                                @SidebarContent
                            </div>
                        }
                    </OsirionStickySidebar>
                }

            </div>
            @if (FooterContent is not null)
            {
                <footer class="osirion-article-page-footer">@FooterContent(Item!)</footer>
            }
            <div>
                
            </div>
        </div>
    }
</div>