<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<!-- NuGet package properties -->
		<PackageId>Osirion.Blazor.Cms.Web</PackageId>
		<Version>4.2.0</Version>
		<Description>Front CMS module for Osirion.Blazor - Provides cms management with provider pattern.</Description>
		<PackageTags>blazor;components;content;cms;markdown;github;osirion</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Markdig" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
		<PackageReference Include="Microsoft.Extensions.Http" />
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.Extensions.Http" />
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Osirion.Blazor.Cms.Core\Osirion.Blazor.Cms.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Osirion.Blazor.Cms.Web.Tests" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Components\Layout\" />
	</ItemGroup>

</Project>
