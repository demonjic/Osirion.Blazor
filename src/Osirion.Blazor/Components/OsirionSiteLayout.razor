@namespace Osirion.Blazor.Components
@inherits LayoutComponentBase
@using Osirion.Blazor.Cms.Web.Components
@using Osirion.Blazor.Navigation.Components
@using Osirion.Blazor.Options
@using Osirion.Blazor.Theming.Components

<OsirionPageLayout StickyFooter EnableHeaderScrollBehavior SkipLinkText="@Site.Labels.SkipLink">
    <Header>
        @if (Site.Announcement is { } announcement)
        {
            <OsirionAnnouncementBar Id="@announcement.Id" RegionLabel="@Site.Labels.Announcement" DismissText="@Site.Labels.DismissAnnouncement">
                @announcement.Text
                @if (!string.IsNullOrWhiteSpace(announcement.LinkUrl))
                {
                    @(" ")<a href="@announcement.LinkUrl">@(announcement.LinkText ?? announcement.LinkUrl)</a>
                }
            </OsirionAnnouncementBar>
        }

        @if (Header is not null)
        {
            @Header
        }
        else
        {
            // The call to action goes in the menu's pinned actions, which stay in the bar when the menu collapses, so
            // on a phone it is not hidden behind the toggle. Without one the menu gets no pinned actions at all.
            RenderFragment? callToActionButton = null;
            if (CallToAction is { } callToAction)
            {
                callToActionButton = @<a class="@CallToActionClass" href="@callToAction.Href" rel="@GetCallToActionRel(callToAction.Href)">@callToAction.Text</a>;
            }

            <Menu AriaLabel="@(MenuLabel ?? Site.Labels.Menu)"
                  ToggleAriaLabel="@Site.Labels.MenuToggle"
                  Href="@Site.HomeUrl"
                  BrandLogo="@Site.LogoUrl"
                  BrandText="@Site.Name"
                  Alignment="MenuAlignment.Right"
                  CollapseBreakpoint="MenuCollapseBreakpoint.Large"
                  PinnedActions="@callToActionButton">
                <ChildContent>
                    @foreach (var item in Site.Menu)
                    {
                        @if (item.Items.Count > 0)
                        {
                            <MenuItem @key="item" Text="@item.Text" Description="@item.Description" HasSubmenu ToggleSubmenuLabel="@Site.Labels.ToggleSubmenu">
                                @foreach (var child in item.Items)
                                {
                                    <MenuItem @key="child" Text="@child.Text" Description="@child.Description" Href="@child.Href" Match="@GetMatch(child)" />
                                }
                            </MenuItem>
                        }
                        else
                        {
                            <MenuItem @key="item" Text="@item.Text" Description="@item.Description" Href="@item.Href" Match="@GetMatch(item)" />
                        }
                    }
                </ChildContent>
                <Actions>
                    @if (Site.ShowSearch)
                    {
                        <SearchBox ActionUrl="@Site.SearchUrl"
                                   Placeholder="@Site.SearchPlaceholder"
                                   Label="@Site.Labels.Search"
                                   SearchButtonText="@Site.Labels.Search"
                                   SubmitLabel="@Site.Labels.SubmitSearch" />
                    }
                    @if (Site.ShowThemeToggle)
                    {
                        <ThemeToggle SwitchToDarkLabel="@Site.Labels.SwitchToDarkTheme" SwitchToLightLabel="@Site.Labels.SwitchToLightTheme" />
                    }
                    @if (ShowsLanguagePicker(SiteLanguagePicker.Header))
                    {
                        <OsirionLanguagePicker Compact AriaLabel="@Site.Labels.Language" />
                    }
                    @MenuActions
                </Actions>
            </Menu>
        }
    </Header>

    <Body>
        @(ChildContent ?? Body)
    </Body>

    <Footer>
        @if (Footer is not null)
        {
            @Footer
        }
        else
        {
            // Passed only when shown, so a footer without the picker keeps its markup.
            RenderFragment? footerLanguagePicker = ShowsLanguagePicker(SiteLanguagePicker.Footer)
                ? @<OsirionLanguagePicker AriaLabel="@Site.Labels.Language" />
                : null;

            <OsirionFooter CompanyName="@(Site.Owner ?? Site.Name)"
                           CompanyUrl="@(Site.OwnerUrl ?? Site.HomeUrl)"
                           Description="@Site.FooterDescription"
                           Links="@FooterSections"
                           SocialLinks="@SocialLinks"
                           BottomLinks="@LegalLinks"
                           BottomLinksLabel="@Site.Labels.LegalLinks"
                           Copyright="@Site.Copyright"
                           SocialTitle="@Site.SocialTitle"
                           ChildContent="@footerLanguagePicker">
                <Logo>
                    <a class="osirion-site-footer-brand" href="@Site.HomeUrl">
                        @if (!string.IsNullOrWhiteSpace(Site.LogoUrl))
                        {
                            <img src="@Site.LogoUrl" width="40" height="40" alt="" />
                        }
                        <span>@Site.Name</span>
                    </a>
                </Logo>
            </OsirionFooter>
        }
    </Footer>
</OsirionPageLayout>

<OsirionStyles />

@if (Site.ShowCookieConsent)
{
    <OsirionCookieConsent @attributes="CookieConsentTexts" Evaluation="@CookieConsentEvaluation" />
}

@if (Site.ShowScrollToTop)
{
    <ScrollToTopProvider />
}
