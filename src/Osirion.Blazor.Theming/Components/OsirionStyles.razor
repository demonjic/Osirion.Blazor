@namespace Osirion.Blazor.Theming.Components
@using Microsoft.Extensions.Options
@using Osirion.Blazor.Components
@using Osirion.Blazor.Theming.Services
@inherits OsirionComponentBase
@inject IOptions<ThemingOptions>? Options
@inject IThemeService ThemeService

@* Assets gives the fingerprinted address under MapStaticAssets, which browsers may cache for a year; without it the
   path is used as written. *@
<link rel="stylesheet" href="@Assets["_content/Osirion.Blazor.Core/css/index.min.css"]" />
@* No link to Osirion.Blazor.Core.bundle.scp.css: the host's {App}.styles.css imports every referenced package's scoped
   styles, so a link here downloaded that bundle (about 250 KB) a second time under another address. *@

@if (!EffectiveOptions.UseDefaultStyles)
{
    @* No adapter for this framework: an empty href would make the browser fetch the page itself as a stylesheet. *@
    @if (!string.IsNullOrEmpty(ThemeAdapter()))
    {
        <link rel="stylesheet" href="@Assets[ThemeAdapter()]" />
    }
    <link rel="stylesheet" href="@Assets["_content/Osirion.Blazor.Theming/css/index.min.css"]" />
}

@if (LinksPalettes)
{
    <link rel="stylesheet" href="@Assets[PaletteStylesheet]" data-osirion-palettes />
}

@if (!string.IsNullOrWhiteSpace(CustomVariables))
{
    <style nonce="@NonceAttribute">
        :root {
            @((MarkupString)NeutralizeStyleEnd(CustomVariables!))
        }
    </style>
}

@if (!string.IsNullOrWhiteSpace(GeneratedVariables))
{
    <style nonce="@NonceAttribute">
        :root {
            @((MarkupString)NeutralizeStyleEnd(GeneratedVariables))
        }
    </style>
}

@LoadScript("./_content/Osirion.Blazor.Theming/js/osirion-styles.js")

<script nonce="@NonceAttribute">
    (function(){
        const config = {
            frameworkClass: '@GetFrameworkClass',
            selectedFramework: '@EffectiveOptions.Framework',
            defaultTheme: '@EffectiveOptions.DefaultMode.ToString().ToLowerInvariant()',
            currentTheme: '@ThemeService.CurrentMode.ToString().ToLowerInvariant()',
            defaultPalette: '@EffectiveOptions.DefaultPalette.ToId()'
        };
        const palettes = ['framework', 'osirion', 'commit', 'editor', 'studio', 'studio-blue', 'contrast'];

        // osirion-styles.js arrives after Blazor starts, so until then the page would paint without the framework
        // adapter and in the light theme. Apply both now, while the page is parsed; the script takes over later.
        function applyBeforeFirstPaint(){
            const html = document.documentElement;
            const match = document.cookie.match(/(?:^|; )osirion-preferred-theme=([^;]*)/);
            let theme = match ? decodeURIComponent(match[1]) : config.defaultTheme;
            if(theme !== 'dark' && theme !== 'light'){
                theme = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }

            if(config.frameworkClass){
                html.classList.add(config.frameworkClass);
            }
            html.setAttribute('data-osirion-theme', theme);
            html.setAttribute('data-osirion-framework', config.selectedFramework);

            const paletteMatch = document.cookie.match(/(?:^|; )osirion-preferred-palette=([^;]*)/);
            const chosen = paletteMatch ? decodeURIComponent(paletteMatch[1]).toLowerCase() : '';
            const palette = palettes.indexOf(chosen) >= 0 ? chosen : config.defaultPalette;
            if(palette === 'framework'){
                html.removeAttribute('data-osirion-palette');
            } else {
                html.setAttribute('data-osirion-palette', palette);
            }

            if(config.selectedFramework === 'Bootstrap'){
                html.setAttribute('data-bs-theme', theme);
            } else if(config.selectedFramework === 'MudBlazor'){
                html.classList.toggle('mud-theme-dark', theme === 'dark');
            } else if(config.selectedFramework === 'FluentUI'){
                html.classList.toggle('fluent-dark-theme', theme === 'dark');
                html.classList.toggle('fluent-light-theme', theme === 'light');
                // Fluent UI Blazor v5 reads its starting mode from body[data-theme]. In <head> the body does not
                // exist yet, so set it as soon as it does.
                const markBody = function(){ document.body.setAttribute('data-theme', theme); };
                if(document.body){
                    markBody();
                } else {
                    document.addEventListener('DOMContentLoaded', markBody, { once: true });
                }
            } else if(config.selectedFramework === 'Radzen'){
                html.classList.toggle('rz-dark-theme', theme === 'dark');
            }
        }

        function init(){
            if(typeof window.initializeOsirionStyles === 'function'){
                window.initializeOsirionStyles(config);
            } else {
                setTimeout(init, 10);
            }
        }

        applyBeforeFirstPaint();
        init();
    })();
</script>