@using Osirion.Blazor.Components

<OsirionCardGrid Columns="3">
    <OsirionFeatureCard Title="Fast pages"
                        Description="HTML on the first request."
                        Items="@(["No client script", "Cache friendly"])">
        <Icon>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" /></svg>
        </Icon>
    </OsirionFeatureCard>
    <OsirionFeatureCard Title="Themed by tokens"
                        Description="One set of colors for every framework."
                        Items="@(["Light and dark", "Six palettes"])">
        <Icon>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 3v18" /></svg>
        </Icon>
    </OsirionFeatureCard>
    <OsirionFeatureCard Title="Accessible markup"
                        Description="Landmarks, headings and labels in place."
                        Items="@(["Keyboard friendly", "Readable contrast"])">
        <Icon>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="5" r="2" /><path d="M5 9h14M12 9v12M8 21l4-6 4 6" /></svg>
        </Icon>
    </OsirionFeatureCard>
</OsirionCardGrid>
