@using Osirion.Blazor.Components

@* The buttons are links to pages of this site, and the size keeps the empty state compact inside the page. The page
   has its own h1, so the title is an h2. *@
<OsirionContentNotFound Title="This page has moved"
                        HeadingLevel="2"
                        Message="We reorganized the docs, and one of these pages may have what you need."
                        ShowIcon="false"
                        ShowSuggestions="true"
                        Suggestions="suggestions"
                        PrimaryButtonText="All components"
                        PrimaryButtonUrl="/components"
                        Variant="centered"
                        Size="small" />

@code {
    private static readonly ContentNotFoundSuggestion[] suggestions =
    [
        new() { Text = "Contact form", Url = "/components/contact-form", Description = "A form that validates on the server." },
        new() { Text = "Forms and feedback", Url = "/components/forms-and-feedback" }
    ];
}
