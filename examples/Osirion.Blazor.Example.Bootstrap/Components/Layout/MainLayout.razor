@using Osirion.Blazor.Components
@using Osirion.Blazor.Navigation.Components
@using Osirion.Blazor.Theming.Components
@inherits LayoutComponentBase

<OsirionPageLayout StickyFooter EnableHeaderScrollBehavior>
    <Header>
        <OsirionAnnouncementBar Id="themes-4-1">
            New in 4.1: color palettes and a palette picker. <a href="/themes">See the themes</a>
        </OsirionAnnouncementBar>
        <NavMenu />
    </Header>

    <Body>
        @Body
    </Body>

    <Footer>
        <Footer />
    </Footer>
</OsirionPageLayout>

<OsirionStyles />
@* The library's default message says that browsing on means agreeing, which consent does not allow; say what is asked. *@
<OsirionCookieConsent Message="getosirion.com would like to use analytics cookies to see which pages are read. Nothing is set until you choose."
                      PolicyLink="/privacy-policy"
                      PolicyLinkText="Privacy policy" />
<ScrollToTopProvider />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
