<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <CentralPackageFloatingVersionsEnabled>false</CentralPackageFloatingVersionsEnabled>
    <Net9MicrosoftVersion>9.0.21</Net9MicrosoftVersion>
    <Net10MicrosoftVersion>10.0.14</Net10MicrosoftVersion>
  </PropertyGroup>

  <ItemGroup Label="Common packages">
    <PackageVersion Include="AngleSharp" Version="1.8.5" />
    <PackageVersion Include="Blazored.LocalStorage" Version="4.5.0" />
    <PackageVersion Include="BlazorJSComponents" Version="1.0.0" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="HtmlSanitizer" Version="9.2.1039" />
    <PackageVersion Include="Markdig" Version="1.4.1" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.403" />
    <PackageVersion Include="Octokit" Version="14.0.0" />
    <PackageVersion Include="Scrutor" Version="7.0.0" />
    <PackageVersion Include="System.IO.Abstractions" Version="22.3.0" />
    <PackageVersion Include="System.IO.Abstractions.TestingHelpers" Version="22.3.0" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup Label="Test packages">
    <PackageVersion Include="bUnit" Version="2.11.3" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(Net10MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.63.0" />
    <PackageVersion Include="Microsoft.Playwright.TestAdapter" Version="1.63.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup Label="Example packages">
    <PackageVersion Include="Microsoft.FluentUI.AspNetCore.Components" Version="5.0.1" />
    <PackageVersion Include="MudBlazor" Version="9.11.0" />
    <!-- Transitive through the Aspire AppHost SDK. Pinned past GHSA-qhrr-8q5h-9q3h (fixed in 2.5.303), which NU1902
         turns into a restore error for the whole solution. -->
    <PackageVersion Include="MessagePack" Version="2.5.307" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'" Label=".NET 9 Microsoft packages">
    <PackageVersion Include="Microsoft.AspNetCore.Components" Version="$(Net9MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="$(Net9MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.WebUtilities" Version="$(Net9MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="$(Net9MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="$(Net9MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="$(Net9MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(Net9MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="$(Net9MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="$(Net9MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(Net9MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="$(Net9MicrosoftVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'" Label=".NET 10 Microsoft packages">
    <PackageVersion Include="Microsoft.AspNetCore.Components" Version="$(Net10MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="$(Net10MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.WebUtilities" Version="$(Net10MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="$(Net10MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="$(Net10MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="$(Net10MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(Net10MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="$(Net10MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="$(Net10MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(Net10MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="$(Net10MicrosoftVersion)" />
  </ItemGroup>
</Project>